# (선택) YouTube Data API v3 키. 설정하면 링크 대신 검색어로 곡을 찾을 수 있습니다.
# 주의: 클라이언트 번들에 포함되므로 반드시 HTTP 리퍼러 제한을 건 키를 사용하세요.
VITE_YOUTUBE_API_KEY=

# (선택) 자체 PeerJS 시그널링 서버. 비워두면 PeerJS 공개 클라우드 서버(0.peerjs.com)를 사용합니다.
VITE_PEER_HOST=
VITE_PEER_PORT=
VITE_PEER_PATH=
VITE_PEER_SECURE=

# (선택) 학교/회사 와이파이처럼 P2P가 막힌 네트워크용 TURN 중계 서버 (예: metered.ca 무료 플랜)
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
# 비워두면 Metered 기본 주소 사용. 다른 업체면 쉼표로 구분: turn:host:443,turns:host:443?transport=tcp
VITE_TURN_URLS=
